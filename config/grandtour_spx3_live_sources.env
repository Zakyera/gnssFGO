# Source this INSIDE cbsms_ws_gpu before invoking the existing source runner.
# Explicit choices below must already be set; nothing is launched by this file.
: "${CBSMS_RUN_ROOT:?Choose a fresh /workspace/... parent}"
: "${CBSMS_RUN_NAME:?Choose a new source run name}"
: "${CBSMS_CBS_ENABLE:?Choose true (classic ON) or false (OFF)}"
export CBSMS_RUN_ROOT CBSMS_RUN_NAME CBSMS_CBS_ENABLE
# Route GLIM's ROS stdout into the fresh source-run directory. Kimera's glog
# revision rows remain in estimators.log under the same directory.
export ROS_LOG_DIR="${CBSMS_RUN_ROOT}/${CBSMS_RUN_NAME}/ros_logs"
export CBSMS_PROJECT_ROOT=/workspace/cbs_gtsam4.3
export CBSMS_MISSION=2024-11-02-17-43-10
export CBSMS_BAG_START_SEC=32.0
export CBSMS_BAG_DURATION_SEC=60.0
export CBSMS_BAG_RATE=0.10
export CBSMS_SEED_CLOCK_SECS=1727775007
export CBSMS_ROS_MASTER_PORT=11368
export CBSMS_USE_EXISTING_ROS_MASTER=true
export CBSMS_KIMERA_MODE=stereo_shared_cpt7
export CBSMS_CBS_PROTOCOL=classic
export CBSMS_CBS_DIRECTION=bidirectional
export CBSMS_CBS_ODOM_HORIZON_SEC=0.20
export CBSMS_MAX_HORIZON_PAIRS_PER_UPDATE=1
export CBSMS_ODOM_PUBLISH_STRIDE=1
export CBSMS_CBS_BELIEF_RECEIVE_START_DELAY_SEC=0.0
export CBSMS_GLIM_FACTOR_GRAPH_STRIDE=1
export CBSMS_KIMERA_FACTOR_GRAPH_STRIDE=5
export CBSMS_FACTOR_GRAPH_ENABLE=true
export CBSMS_PRESENTATION_ENABLE=false
export CBSMS_EXPORT_ENDPOINT_AUDIT_ENABLE=true
export KIMERA_CBS_REVISION_AUDIT=1
export CBSMS_DIAGNOSTIC_NODE_OUTPUT=log
export CBSMS_GLIM_CONFIG_SOURCE=/workspace/cbs_gtsam4.3/runs/spx3_full_system_revision_diagnostics_20260927/spx3_off_classic_revisions_nodelog/glim_config
export CBSMS_KIMERA_PROFILE_SOURCE=/workspace/cbs_gtsam4.3/runs/spx3_full_system_revision_diagnostics_20260927/spx3_off_classic_revisions_nodelog/kimera_profile
