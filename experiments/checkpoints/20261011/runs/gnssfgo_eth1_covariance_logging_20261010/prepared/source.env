# Source in the established ROS Noetic container after setting CBSMS_RUN_NAME
# to off_source/on_source and CBSMS_CBS_ENABLE to false/true.
: "${CBSMS_RUN_NAME:?Set fresh ETH1 source run name}"
: "${CBSMS_CBS_ENABLE:?Set false or true}"
export CBSMS_RUN_ROOT=/workspace/cbs_gtsam4.3/runs/gnssfgo_eth1_covariance_logging_20261010/prepared
export CBSMS_RUN_NAME CBSMS_CBS_ENABLE
export ROS_LOG_DIR="${CBSMS_RUN_ROOT}/${CBSMS_RUN_NAME}/ros_logs"
export CBSMS_PROJECT_ROOT=/workspace/cbs_gtsam4.3
export CBSMS_MISSION=2024-10-01-11-29-55
export CBSMS_BAG_START_SEC=0.0
export CBSMS_BAG_DURATION_SEC="${CBSMS_BAG_DURATION_SEC:-10.0}"
export CBSMS_POST_PLAYBACK_DRAIN_SEC=25
export CBSMS_BAG_RATE=0.10
export CBSMS_SEED_CLOCK_SECS=1727775007
export CBSMS_ROS_MASTER_PORT=11393
export CBSMS_USE_EXISTING_ROS_MASTER=true
export CBSMS_KIMERA_MODE=stereo_shared_cpt7
# The recovered classic Kimera source path is "current", not experimental RIGHT.
unset KIMERA_IMU_SAMPLE_SUPPORT
export CBSMS_CBS_PROTOCOL=classic
export CBSMS_CBS_LIVE_REVISION_ENABLE=false
export CBSMS_CBS_DIRECTION=bidirectional
export CBSMS_CBS_ODOM_HORIZON_SEC=0.20
export CBSMS_MAX_HORIZON_PAIRS_PER_UPDATE=1
export CBSMS_ODOM_PUBLISH_STRIDE=1
export CBSMS_CBS_BELIEF_RECEIVE_START_DELAY_SEC=0.0
export CBSMS_GLIM_FACTOR_GRAPH_STRIDE=1
export CBSMS_KIMERA_FACTOR_GRAPH_STRIDE=5
export CBSMS_FACTOR_GRAPH_ENABLE=false
export CBSMS_PRESENTATION_ENABLE=false
export CBSMS_EXPORT_ENDPOINT_AUDIT_ENABLE=true
export KIMERA_CBS_REVISION_AUDIT=1
export CBSMS_GLIM_RECEIVER_AUDIT_MAX_SAMPLES=40
export CBSMS_GLIM_RECEIVER_AUDIT_STRIDE=20
export CBSMS_KIMERA_RECEIVER_AUDIT_MAX_SAMPLES=40
export CBSMS_KIMERA_RECEIVER_AUDIT_STRIDE=20
export CBSMS_DIAGNOSTIC_NODE_OUTPUT=log
export CBSMS_GLIM_CONFIG_SOURCE=/workspace/cbs_gtsam4.3/runs/grandtour_eth1_presentation/grandtour_eth1_stereo_shared_cpt7_no_sidecar_cbs_off_full_346s_20260907/glim_config
export CBSMS_KIMERA_PROFILE_SOURCE=/workspace/cbs_gtsam4.3/runs/grandtour_eth1_presentation/grandtour_eth1_stereo_shared_cpt7_no_sidecar_cbs_off_full_346s_20260907/kimera_profile
